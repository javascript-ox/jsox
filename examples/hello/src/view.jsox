import "@js-ox/ui/theme.css";
import { withSource } from "@js-ox/ui/source";
import source from "./view.jsox?raw";

export function Hello() {
  const root = <main> {
    .className = "wrap"
    <p> { .className = "kicker"; ["Hello"] }
    <h1> { ["JSOX"] }
    <p> {
      .className = "lede"
      ["Nested captures build a tree — "]
      <strong> { ["no JSX closing tags"] }
      ["."]
    }
    <ul> {
      .className = "plain-list"
      for (const item of ["create with <tag>", "reuse with [object]", "insert with [value]"]) {
        <li> { [item] }
      }
    }
  }
  return withSource(root, source);
}
