import "@jsox/ui/theme.css";
import Navigo from "navigo";
import { Hello } from "@jsox/hello";
import { Counter } from "@jsox/counter";
import { Todo } from "@jsox/todo";
import { Pojo } from "@jsox/pojo";
import { Rxjs } from "@jsox/rxjs";

const github = "https://github.com/javascript-ox/jsox";

const vanillaSrc = `const el = document.createElement("button");
el.type = "button";
el.className = "btn";
el.textContent = "Ship it";
parent.append(el);`;

const jsoxSrc = `const el = <button> {
  .type = "button"
  .className = "btn"
  ["Ship it"]
}
[parent] { [el] }`;

const jsxSrc = `const el = (
  <button type="button" className="btn">
    Ship it
  </button>
);`;

const examples = [
  {
    href: "#/hello",
    kicker: "01",
    title: "Hello",
    blurb: "Nested tags, text captures, and a for-of list — without closing tags.",
  },
  {
    href: "#/counter",
    kicker: "02",
    title: "Counter",
    blurb: "Capture a node, keep the reference, and update it. State is an ordinary variable.",
  },
  {
    href: "#/todo",
    kicker: "03",
    title: "Todo",
    blurb: "Build an item and insert it onto a live list. The tree is the data structure.",
  },
  {
    href: "#/pojo",
    kicker: "04",
    title: "POJO",
    blurb: "The same syntax builds plain objects. If the target implements add(), JSOX uses it.",
  },
  {
    href: "#/rxjs",
    kicker: "05",
    title: "RxJS",
    blurb: "JSOX constructs the DOM. Streams own the updates — no render cycle in between.",
  },
];

const pillars = [
  {
    mark: "<tag>",
    title: "Create",
    body: "A tag constructs an element. The block that follows is its initializer, with this bound to the new node.",
  },
  {
    mark: ".prop",
    title: "Configure",
    body: "A leading dot is this. .className is this.className. Properties and methods stay on the object you just created.",
  },
  {
    mark: "[value]",
    title: "Insert",
    body: "Brackets insert a child: a string, a node, or the result of a call. Anything that belongs on the tree can go in brackets.",
  },
];

const boasts = [
  { n: "0", l: "closing tags" },
  { n: "0", l: "virtual DOM" },
  { n: "0", l: "runtime library" },
  { n: "1", l: "compile step" },
];

const ticker = [
  "<button>",
  ".className",
  "[child]",
  "this",
  "POJO",
  "DOM",
  "compile-time",
  "JavaScript",
  ".onclick",
  "[list]",
  "<custom-el>",
];

function Home() {
  return <main> {
    .className = "home"
    <section> {
      .className = "hero"
      <div> {
        .className = "hero-inner"
        <p> { .className = "kicker kicker-light"; ["JavaScript Object eXtensions"] }
        <h1> {
          .className = "hero-title"
          ["Nested objects, "]
          <em> { ["in the language"] }
          [" you already write."]
        }
        <p> {
          .className = "hero-lede"
          ["JSOX is a small JavaScript dialect for building trees — DOM nodes or plain objects — without JSX and without a framework. Tags construct, leading dots bind this, brackets insert children. It compiles to ordinary JavaScript and then gets out of the way."]
        }
        <div> {
          .className = "cta-row"
          <a> { .className = "cta cta-solid"; .href = "#/hello"; ["See it live"] }
          <a> {
            .className = "cta cta-ghost"
            .href = github
            .target = "_blank"
            .rel = "noreferrer"
            ["View on GitHub"]
          }
        }
        <ul> {
          .className = "boasts"
          for (const b of boasts) {
            <li> {
              <strong> { [b.n] }
              <span> { [b.l] }
            }
          }
        }
      }
    }

    <div> {
      .className = "ticker"
      .setAttribute("aria-hidden", "true")
      <div> {
        .className = "ticker-track"
        for (const bit of [...ticker, ...ticker]) {
          <span> { [bit] }
        }
      }
    }

    <section> {
      .className = "home-wrap"
      <p> { .className = "kicker"; ["Three marks. That is the whole dialect."] }
      <h2> { .className = "section-title"; ["Construction, without the ceremony."] }
      <p> {
        .className = "section-lede"
        ["Not a runtime, not a renderer, and not a new component model. Three pieces of syntax that compile to the JavaScript you would have written by hand."]
      }
      <ul> {
        .className = "pillars"
        for (const p of pillars) {
          <li> {
            .className = "pillar"
            <p> { .className = "pillar-mark"; [p.mark] }
            <h3> { [p.title] }
            <p> { [p.body] }
          }
        }
      }
    }

    <section> {
      .className = "compare-band"
      <div> {
        .className = "home-wrap"
        <p> { .className = "kicker"; ["Same button, three spellings"] }
        <h2> { .className = "section-title"; ["What you write should look like the tree."] }
        <div> {
          .className = "compare"
          <figure> {
            .className = "code-pane"
            <figcaption> { ["Vanilla JavaScript"] }
            <pre> { .className = "code"; [vanillaSrc] }
          }
          <figure> {
            .className = "code-pane code-pane-accent"
            <figcaption> { ["JSOX"] }
            <pre> { .className = "code"; [jsoxSrc] }
          }
          <figure> {
            .className = "code-pane"
            <figcaption> { ["JSX"] }
            <pre> { .className = "code"; [jsxSrc] }
          }
        }
        <p> {
          .className = "compare-note"
          ["No virtual DOM, no extra import, no closing tags. JSOX compiles to the same create-and-assign JavaScript you would write yourself — just without the repetition."]
        }
      }
    }

    <section> {
      .className = "home-wrap manifesto"
      <p> { .className = "kicker"; ["Design"] }
      <h2> { .className = "section-title"; ["A dialect, not a framework."] }
      <ol> {
        .className = "manifesto-list"
        <li> { ["JavaScript already has objects. Nested construction should read like the structure you mean, not a sequence of factory calls."] }
        <li> { ["Inside a construct block, this is the node. A leading .prop is this.prop — the same object, with less noise."] }
        <li> { ["[value] inserts a child: text, an element, or the result of a call. One syntax for membership on the tree."] }
        <li> { ["The target can be an HTMLElement, a plain object with add(), or an array that can push. Trees are not only for the DOM."] }
        <li> { ["You still write JavaScript and you still ship JavaScript. JSOX is a compile-time spelling, not a new runtime."] }
      }
    }

    <section> {
      .className = "home-wrap"
      <p> { .className = "kicker"; ["Examples"] }
      <h2> { .className = "section-title"; ["Five small apps, one dialect."] }
      <p> {
        .className = "section-lede"
        ["Each example is a real page. Open a counter, add a task, or watch RxJS update a clock that JSOX only had to build once."]
      }
      <ul> {
        .className = "grid pitch-grid"
        for (const ex of examples) {
          <li> {
            <a> {
              .className = "card pitch-card"
              .href = ex.href
              <p> { .className = "kicker"; [ex.kicker] }
              <h2> { [ex.title] }
              <p> { [ex.blurb] }
            }
          }
        }
      }
    }

    <section> {
      .className = "closer"
      <div> {
        .className = "home-wrap closer-inner"
        <p> { .className = "kicker kicker-light"; ["Get started"] }
        <h2> { .className = "section-title section-title-light"; ["Write a tag. Leave it open. Keep going."] }
        <p> {
          .className = "hero-lede"
          ["JSOX is a compile-time dialect. Add the compiler, name the file .jsox, and start nesting. It works with the bundler you already have."]
        }
        <div> {
          .className = "cta-row"
          <a> { .className = "cta cta-solid"; .href = "#/hello"; ["Open the first example"] }
          <a> {
            .className = "cta cta-ghost"
            .href = github
            .target = "_blank"
            .rel = "noreferrer"
            ["Read the source"]
          }
        }
      }
    }
  }
}

function Missing() {
  return <main> {
    .className = "wrap"
    <p> { .className = "kicker"; ["404"] }
    <h1> { ["This page has no route."] }
    <p> {
      .className = "lede"
      <a> { .href = "#/"; ["Back to the overview"] }
    }
  }
}

const outlet = document.createElement("div");
outlet.className = "outlet";

function mount(view) {
  outlet.replaceChildren();
  const node = view();
  if (node != null) outlet.append(node);
}

const router = new Navigo("/", { hash: true });
router
  .on("/", () => mount(Home))
  .on("/hello", () => mount(Hello))
  .on("/counter", () => mount(Counter))
  .on("/todo", () => mount(Todo))
  .on("/pojo", () => mount(Pojo))
  .on("/rxjs", () => mount(Rxjs))
  .notFound(() => mount(Missing));

function markActive() {
  const here = location.hash || "#/";
  document.body.classList.toggle("is-home", here === "#/" || here === "");
  for (const a of document.querySelectorAll(".site-nav a[href^='#']")) {
    a.classList.toggle("is-active", a.getAttribute("href") === here);
  }
}

window.addEventListener("hashchange", markActive);

const chrome = <div> {
  <header> {
    .className = "site-nav"
    <a> { .className = "brand"; .href = "#/"; ["JSOX"] }
    <a> { .href = "#/hello"; ["Hello"] }
    <a> { .href = "#/counter"; ["Counter"] }
    <a> { .href = "#/todo"; ["Todo"] }
    <a> { .href = "#/pojo"; ["POJO"] }
    <a> { .href = "#/rxjs"; ["RxJS"] }
    <a> {
      .className = "nav-extra"
      .href = github
      .target = "_blank"
      .rel = "noreferrer"
      ["GitHub"]
    }
  }
  [outlet]
  <footer> {
    .className = "site-foot"
    <p> {
      ["JSOX — JavaScript Object eXtensions. A compile-time dialect for nested construction."]
    }
    <p> {
      <a> { .href = github; .target = "_blank"; .rel = "noreferrer"; ["github.com/javascript-ox/jsox"] }
    }
  }
}

[document.body] {
  [chrome]
}

router.resolve();
markActive();
