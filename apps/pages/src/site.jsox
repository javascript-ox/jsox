import { defineComponent } from "@js-ox/web-components";
import { currentPath, resolveRoute } from "./routes.js";

const github = "https://github.com/javascript-ox/jsox";
const isDevelopment = import.meta.env.VITE_JSOX_CHANNEL === "develop";
const siteState = new WeakMap();

function render(site) {
  const path = currentPath();
  const outlet = site.querySelector(".outlet");
  const channelSwitch = site.querySelector(".channel-switch");
  const channelUrl = new URL(isDevelopment ? "../" : "develop/", document.baseURI);
  channelUrl.hash = `#${path}`;
  channelSwitch.href = channelUrl.href;
  outlet.replaceChildren(document.createElement(resolveRoute(path)));
  document.body.classList.toggle("is-home", path === "/");
  document.body.classList.toggle("is-development", isDevelopment);

  for (const link of site.querySelectorAll(".site-nav a[href^='#']")) {
    link.classList.toggle("is-active", link.getAttribute("href") === `#${path}`);
  }
}

[defineComponent("jsox-site")] {
  .template = <div> {
    <header> {
      .className = "site-nav"
      <a> { .className = "brand"; .href = "#/"; ["JSOX"] }
      <a> { .href = "#/start"; ["Quick Start"] }
      <a> { .href = "#/tutorial"; ["Basic Tutorial"] }
      <a> {
        .className = "channel-switch nav-extra"
        if (isDevelopment) {
          <span> { .className = "channel-badge"; ["Development"] }
          ["View stable"]
        } else {
          ["View development"]
        }
      }
      <a> {
        .href = github
        .target = "_blank"
        .rel = "noopener noreferrer"
        ["GitHub"]
      }
    }
    <div> { .className = "outlet" }
    <footer> {
      .className = "site-foot"
      <p> { ["JSOX — JavaScript Object eXtensions. A compile-time dialect for constructing objects."] }
      <p> {
        <a> { .href = github; .target = "_blank"; .rel = "noreferrer"; ["github.com/javascript-ox/jsox"] }
      }
    }
  }
  .connected = function () {
    if (siteState.has(this)) return
    const onHashChange = () => render(this)
    siteState.set(this, onHashChange)
    window.addEventListener("hashchange", onHashChange)
    render(this)
  }
  .disconnected = function () {
    const onHashChange = siteState.get(this)
    if (!onHashChange) return
    window.removeEventListener("hashchange", onHashChange)
    siteState.delete(this)
  }
  .register()
}
