    "./vite": "./src/vite-plugin.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javascript-ox/jsox.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/javascript-ox/jsox",
  "bugs": {
    "url": "https://github.com/javascript-ox/jsox/issues"
  },
  "keywords": [
