  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "js-tokens": "^9.0.1",
    "oxc-parser": "^0.95.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
